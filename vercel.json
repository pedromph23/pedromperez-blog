{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "bash vercel-build.sh",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "config/**",
        "blog/**",
        "projects/**",
        "core/**",
        "templates/**",
        "theme/**",
        "static/**",
        "staticfiles/**",
        "manage.py",
        "requirements.txt"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
